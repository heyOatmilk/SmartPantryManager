<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="16dp" android:background="#FFFFFF">

    <TextView android:id="@+id/tvItemName" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textColor="#2F5D50"
        android:textSize="18sp" android:textStyle="bold" />

    <TextView android:id="@+id/tvItemQuantity" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textColor="#333333" android:textSize="15sp" />

    <TextView android:id="@+id/tvItemExpiry" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textColor="#777777" android:textSize="13sp" />

    <TextView android:id="@+id/tvExpiryWarning" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="⚠ Expiring Soon" android:textColor="#B85C38"
        android:textSize="13sp" android:textStyle="bold" android:visibility="gone" />

</LinearLayout>